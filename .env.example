# =============================================================================
# Open API Portal - Environment Configuration Template
# Copy this file to .env and adjust the values as needed for your environment.
# =============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (SQLite)
# Path relative to project root or absolute path
DATABASE_PATH=./storage/portal.db

# Cryptography & Token Storage
# 32-byte secret key used to encrypt Git personal access tokens in the database
ENCRYPTION_SECRET=open-api-portal-secret-key-2026-secure-32byte!

# Initial Administrative User (Seeded on first run when no users exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@portal.local
INITIAL_ADMIN_PASSWORD=admin123

# Companion Mock Server Configuration (Optional)
MOCK_PORT=4000
MOCK_URL=http://localhost:4000
