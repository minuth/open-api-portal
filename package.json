{
  "name": "open-api-portal",
  "version": "1.0.0",
  "description": "Centralized OpenAPI management portal built with Hono, Hono JSX, HTMX, and Alpine.js",
  "main": "src/index.tsx",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.tsx",
    "dev:mock": "tsx watch --env-file-if-exists=.env src/index.tsx",
    "build": "tsc --noEmit",
    "start": "tsx src/index.tsx",
    "db:generate": "drizzle-kit generate",
    "test:mock": "tsx --env-file-if-exists=.env test/mock-api-test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "jose": "^6.2.10",
    "js-yaml": "^5.2.3",
    "marked": "^18.0.12",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
